# Copy to k8s/oracle-k3s.env, replace every placeholder, and do not commit that file.
# This template targets the Oracle Always Free k3s demo overlay with in-cluster Postgres, Redis, and MinIO.

# App/runtime
APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true

# Database
DATABASE_URL=postgresql+psycopg2://video:video@video-processing-postgres:5432/video

# Redis / queue
REDIS_URL=redis://video-processing-redis:6379/0
QUEUE_NAME=video-processing
RQ_JOB_TIMEOUT_SECONDS=600

# Object storage
STORAGE_BACKEND=object
OBJECT_STORAGE_ENDPOINT=http://video-processing-minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://REPLACE_WITH_PUBLIC_HOST_OR_TUNNEL:9000
OBJECT_STORAGE_ACCESS_KEY=replace-me
OBJECT_STORAGE_SECRET_KEY=replace-me
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_SECURE=false
RAW_VIDEO_BUCKET=raw-videos
PROCESSED_VIDEO_BUCKET=processed-videos
THUMBNAIL_BUCKET=thumbnails
PRESIGNED_URL_EXPIRES_SECONDS=3600

# Upload validation/protection
UPLOAD_VALIDATION_ENABLED=true
MAX_UPLOAD_BYTES=104857600
ALLOWED_VIDEO_EXTENSIONS=.mp4,.mov,.mkv,.webm
ALLOWED_VIDEO_CONTENT_TYPES=video/mp4,video/quicktime,video/x-matroska,video/webm,application/octet-stream
UPLOAD_ADMISSION_CONTROL_ENABLED=true
MAX_QUEUE_DEPTH_FOR_UPLOADS=50
MIN_AVAILABLE_WORKERS_FOR_UPLOADS=1
UPLOAD_RATE_LIMIT_ENABLED=true
UPLOAD_RATE_LIMIT_MAX_REQUESTS=10
UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60

# Idempotency
UPLOAD_IDEMPOTENCY_ENABLED=true
IDEMPOTENCY_KEY_MAX_LENGTH=128

# Admin auth
ADMIN_AUTH_ENABLED=true
ADMIN_API_KEY=replace-with-strong-admin-key

# Reconciler / stuck job recovery
STUCK_PROCESSING_TIMEOUT_SECONDS=300
STUCK_QUEUED_TIMEOUT_SECONDS=300
STUCK_JOB_RECOVERY_ENABLED=true
RECONCILER_ENABLED=true
RECONCILER_INTERVAL_SECONDS=60
RECONCILER_STARTUP_DELAY_SECONDS=10
RECONCILER_ONESHOT=false
RECONCILER_LOCK_ENABLED=true
RECONCILER_LOCK_KEY=reconciler:stuck-job-recovery
RECONCILER_LOCK_TTL_SECONDS=55
RECONCILER_LOCK_ACQUIRE_TIMEOUT_SECONDS=2

# Cleanup / retention
CLEANUP_ENABLED=true
CLEANUP_COMPLETED_AFTER_DAYS=7
CLEANUP_FAILED_AFTER_DAYS=14
CLEANUP_DELETE_DB_ROWS=false
CLEANUP_BATCH_SIZE=100

# Metrics / tracing
WORKER_METRICS_PORT=9100
RECONCILER_METRICS_PORT=9200
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# CORS / frontend
CORS_ALLOWED_ORIGINS=http://REPLACE_WITH_FRONTEND_ORIGIN
NEXT_PUBLIC_API_BASE_URL=http://REPLACE_WITH_API_ORIGIN
